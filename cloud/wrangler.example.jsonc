{
  "name": "stream-companions-example",
  "main": "worker.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stream-companions-example",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ENCOUNTER_EVENTS",
        "class_name": "EncounterEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "encounter-events-v1",
      "new_sqlite_classes": [
        "EncounterEvents"
      ]
    }
  ]
}
