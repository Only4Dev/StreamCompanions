{
  "name": "stream-companions",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "node scripts/prepare-sprite-credits.js && electron-builder --config scripts/release-build.cjs --win portable --x64 --publish never",
    "dist:beta": "electron-builder --config scripts/beta-build.cjs --win portable --x64 --publish never",
    "import:pmd": "node scripts/import-pmd.js",
    "dist:folder": "node scripts/prepare-sprite-credits.js && electron-builder --config scripts/release-build.cjs --win dir --x64 --publish never"
  },
  "build": {
    "appId": "community.streamcompanions.desktop",
    "productName": "Stream Companions",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "ui/**",
      "package.json",
      "dev/battle.js",
      "dev/battle-vfx.js",
      "dev/battle-ui.js",
      "dev/battle.css",
      "dev/national-stats.js"
    ]
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
